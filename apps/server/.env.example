# BaziGB Server environment (production)
# Copy to .env and fill in real values.

# PostgreSQL connection string (the server expects Postgres in production)
DATABASE_URL="postgresql://bazigb:CHANGE_ME_PASSWORD@db:5432/bazigb?schema=public"

# JWT — use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET="CHANGE_ME_STRONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"

# Port the NestJS server listens on (inside Docker, keep 3001)
PORT=3001

# Comma-separated list of allowed browser origins (no trailing slash)
# e.g. ALLOWED_ORIGINS="https://bazigb.example.com"
ALLOWED_ORIGINS=""

# sms.ir OTP delivery — API key from the panel (developer keys) + verification
# template id (the "کد تایید" template). When SMSIR_API_KEY is empty the code
# is only logged to the console (dev mode).
SMSIR_API_KEY=""
SMSIR_TEMPLATE_ID=""
