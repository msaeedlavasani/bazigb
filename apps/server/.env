# SQLite for local development. For Postgres, switch to e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/bazigb?schema=public"
DATABASE_URL="file:./dev.db"

# JWT secret — replace with a strong random value before production
JWT_SECRET="bazigb-dev-secret-change-me"

# Token lifetime
JWT_EXPIRES_IN="7d"
