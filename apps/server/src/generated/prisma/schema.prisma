// BaziGB Prisma Schema
//
// Local development uses SQLite (file:./dev.db) for instant build stability.
// To migrate to PostgreSQL:
//   1. Change the datasource `provider` below to "postgresql"
//   2. Set DATABASE_URL in .env to a postgres:// connection string
//   3. Run `npm run prisma:migrate` (creates migrations and applies them)
//
// NOTE: SQLite has no native enum support, so `Room.status` / `Room.gameType`
// are stored as strings. They can be swapped for enums after moving to Postgres.

generator client {
  provider = "prisma-client-js"
  // Custom output (monorepo-safe): avoids the hoisted node_modules/.prisma
  // location and keeps generated types inside the workspace.
  // Path is relative to this file (prisma/).
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  username  String   @unique
  wins      Int      @default(0)
  losses    Int      @default(0)
  rating    Int      @default(1200) // ELO rating, seeded at 1200
  createdAt DateTime @default(now())

  gameHistoryWins GameHistory[]      @relation("GameWinner")
  tournamentsWon  Tournament[]       @relation("TournamentWinner")
  tournamentSlots TournamentPlayer[]
  matchAsPlayerA  TournamentMatch[]  @relation("MatchPlayerA")
  matchAsPlayerB  TournamentMatch[]  @relation("MatchPlayerB")
  matchWins       TournamentMatch[]  @relation("MatchWinner")

  @@map("users")
}

model Room {
  id           String   @id @default(cuid())
  code         String   @unique
  status       String   @default("waiting") // waiting | playing | finished
  gameType     String
  players      String   @default("[]") // JSON array of seated player user ids
  currentState String? // JSON serialized game state (null until the game starts)
  winnerId     String? // player user id that won (null for draw / unfinished)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  games GameHistory[]

  @@map("rooms")
}

model GameHistory {
  id        String   @id @default(cuid())
  winnerId  String?
  roomId    String
  gameName  String   @default("tic-tac-toe")
  players   String   @default("[]") // JSON array of participating user ids
  data      String   @default("{}") // JSON string with game-specific result data (final state)
  createdAt DateTime @default(now())

  winner User? @relation("GameWinner", fields: [winnerId], references: [id])
  room   Room  @relation(fields: [roomId], references: [id])

  @@index([roomId])
  @@index([winnerId])
  @@map("game_histories")
}

// ---------------------------------------------------------------------------
// Tournaments: single-elimination knockout brackets.
//
// lifecycle: registration -> seeded -> in_progress -> completed
// - `bracket` stores the serialized bracket tree (rounds + match ids).
// - Round 1 is the first round; `bracketIndex` is the 0-based position of a
//   match inside its round. A match's winner advances to `nextMatchId`.
// ---------------------------------------------------------------------------

model Tournament {
  id         String   @id @default(cuid())
  name       String
  gameType   String   @default("tic-tac-toe")
  status     String   @default("registration") // registration | seeded | in_progress | completed
  maxPlayers Int      @default(16)
  bracket    String? // JSON serialized bracket tree (rounds -> match ids)
  winnerId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  winner  User?              @relation("TournamentWinner", fields: [winnerId], references: [id])
  players TournamentPlayer[]
  matches TournamentMatch[]

  @@index([status])
  @@map("tournaments")
}

model TournamentPlayer {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  seed         Int      @default(0) // 1-based seeding order (assigned when the bracket is seeded)
  joinedAt     DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@map("tournament_players")
}

model TournamentMatch {
  id           String    @id @default(cuid())
  tournamentId String
  round        Int       @default(1) // 1 = first round
  bracketIndex Int       @default(0) // 0-based position inside the round
  playerAId    String?
  playerBId    String?
  winnerId     String?
  nextMatchId  String? // match the winner advances to (null for the final)
  status       String    @default("pending") // pending | in_progress | completed
  playedAt     DateTime?

  tournament      Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerA         User?             @relation("MatchPlayerA", fields: [playerAId], references: [id])
  playerB         User?             @relation("MatchPlayerB", fields: [playerBId], references: [id])
  winner          User?             @relation("MatchWinner", fields: [winnerId], references: [id])
  nextMatch       TournamentMatch?  @relation("NextMatch", fields: [nextMatchId], references: [id])
  previousMatches TournamentMatch[] @relation("NextMatch")

  @@unique([tournamentId, round, bracketIndex])
  @@index([tournamentId, status])
  @@map("tournament_matches")
}
