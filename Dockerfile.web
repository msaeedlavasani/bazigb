# BaziGB Web — production image
# Next.js standalone output inside the npm-workspaces monorepo.

# ---------- Stage 1: install dependencies ----------
FROM node:20-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/ apps/
COPY packages/ packages/
RUN npm ci

# ---------- Stage 2: build ----------
FROM node:20-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY --from=deps /app/apps ./apps
COPY --from=deps /app/packages ./packages

# Build engine + the game packages the web app imports at runtime
RUN npm run build --workspace=@bazigb/engine \
 && npm run build --workspace=@bazigb/game-tic-tac-toe \
 && npm run build --workspace=@bazigb/game-chess \
 && npm run build --workspace=@bazigb/game-backgammon \
 && npm run build --workspace=@bazigb/game-vegas

# NEXT_PUBLIC_* are inlined at build time — pass them as build args
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SOCKET_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SOCKET_URL=$NEXT_PUBLIC_SOCKET_URL

RUN npm run build --workspace=@bazigb/web

# ---------- Stage 3: runtime ----------
FROM node:20-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

# Next standalone output (traced node_modules + server.js)
COPY --from=builder /app/apps/web/.next/standalone ./
# Static assets and public files
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

EXPOSE 3000
CMD ["node", "apps/web/server.js"]
