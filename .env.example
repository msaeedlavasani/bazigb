# BaziGB production environment
# Copy to `.env` and fill in real values before running deploy.sh

# PostgreSQL password (the app connects as user `bazigb` to database `bazigb`)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RANDOM_HEX_64
JWT_EXPIRES_IN=7d

# Public domain (no scheme, no trailing slash). Empty = plain HTTP on the IP.
# Example: bazigb.example.com
DOMAIN=

# Browser origins allowed to call the API (comma-separated). Leave empty for
# dev (any origin); set to your site origin in production, e.g.:
#   ALLOWED_ORIGINS=https://bazigb.example.com
ALLOWED_ORIGINS=

# Same-origin routing (keep empty) — Caddy proxies /api/* and /socket.io/*
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=

# ---- SMS OTP (sms.ir) ----
# API key from the sms.ir panel (برنامه‌نویسان → لیست کلیدهای API).
# Leave empty for dev mode: codes are only logged to the server console.
SMSIR_API_KEY=
# "کد تایید" template id defined in the sms.ir panel (sandbox default: 123456).
SMSIR_TEMPLATE_ID=123456
