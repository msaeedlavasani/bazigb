{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "lib": ["ESNext", "DOM"],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@bazigb/engine": ["packages/engine/src"],
      "@bazigb/game-*": ["packages/games/*/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
