{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "lib": ["ESNext", "DOM"],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@bazigb/engine": [
        "packages/engine/dist"
      ],
      "@bazigb/game-*": [
        "packages/games/*/dist"
      ]
    }
  },
  "exclude": ["node_modules", "dist"]
}
